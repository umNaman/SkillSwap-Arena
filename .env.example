# SQLite works out of the box. PostgreSQL is also supported via
# postgresql+asyncpg://<user>:<password>@<host>:5432/<database>
DATABASE_URL=sqlite+aiosqlite:///./skillswap.db

# Authentication
# Generate a local value, for example: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Agora API configuration
# Both values come from the same token-authenticated Agora project.
# Keep AGORA_APP_CERTIFICATE on the backend only.
AGORA_APP_ID=
AGORA_APP_CERTIFICATE=
AGORA_TOKEN_EXPIRE_SECONDS=3600

# OpenAI API configuration
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# CORS Settings
CORS_ORIGINS=["*"]

# GD Configuration
# Total experience: 2 minutes preparation + 13 minutes live discussion.
GD_ROUND_DURATION=900
GD_PREPARATION_DURATION=120
GD_DISCUSSION_DURATION=780
# Abandoned rooms are recovered only when no WebSocket clients are connected.
STALE_PRESTART_SESSION_SECONDS=600
STALE_IN_PROGRESS_GRACE_SECONDS=300
MAX_SEATS=6
PUBLIC_ROOM_POOL_SIZE=3
SEED_DEMO_DATA=true
